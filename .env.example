# Copy this file to ".env" in the project root for the Vite frontend.

# Supabase project URL and public anon key (safe for the browser; access is
# enforced by Supabase row-level security, not by keeping this key secret).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Absolute URL of the deployed backend (e.g. your Railway URL). Leave blank in
# local dev — Vite proxies /api/* to http://localhost:3001 instead (vite.config.js).
VITE_API_BASE_URL=

# "true" to show the on-screen voice-debug diagnostics panel. Leave blank/false otherwise.
VITE_SHOW_VOICE_DEBUG=
