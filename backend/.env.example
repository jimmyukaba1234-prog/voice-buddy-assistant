# Copy this file to ".env" (in the backend/ folder) and fill in your values.

# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model to use.
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs voice engine. Keep the API key backend-only.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Port the Express backend listens on.
PORT=3001

# Timeout (ms) for the Gemini memory-review call before falling back to the
# regex-only memory extraction.
MEMORY_REVIEW_TIMEOUT_MS=10000

# Supabase project settings. SUPABASE_SERVICE_ROLE_KEY is used server-side to
# verify session tokens (requireAuth) and to write tool_runs audit log rows.
# It bypasses row-level security — keep it backend-only, never in frontend code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
